@page "/signup"

<div class="flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md p-8 space-y-6 bg-white rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold text-center text-gray-800">Sign-Up</h2>

            <form class="space-y-4">
            <div>
                <label class="block mb-1 text-gray-600">Email</label>
                <input type="email" placeholder="Enter your email"
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
            </div>

            <div>
                <label class="block mb-1 text-gray-600">Password</label>
                <input type="password" placeholder="Enter your password"
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
            </div>

            <div>
                <label class="block mb-1 text-gray-600">Retype-Password</label>
                <input type="password" placeholder="Enter your password"
                       class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"  required/>
            </div>



            <button class="w-full py-2 mt-4 font-semibold text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                Create Account
            </button>
            </form>
    </div>
</div>


