@page "/signup"
@using System.ComponentModel.DataAnnotations
@using Data
@using Microsoft.EntityFrameworkCore
@using MauiApp2.Services
@inject AppDbContext DbContext

<div class="flex items-center justify-center min-h-screen">
    <div class="w-full max-w-md p-8 space-y-6 bg-white rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold text-center text-gray-800">Sign-Up</h2>

        <EditForm Model="model" OnValidSubmit="HandleSignup">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label class="block mb-1 text-gray-600">Email</label>
                <InputText @bind-Value="model.Email"
                           class="w-full px-4 py-2 border rounded-lg" />
            </div>

            <div>
                <label class="block mb-1 text-gray-600">Password</label>
                <InputText @bind-Value="model.Password"
                           type="password"
                           class="w-full px-4 py-2 border rounded-lg" />
            </div>

            <div>
                <label class="block mb-1 text-gray-600">Retype Password</label>
                <InputText @bind-Value="model.ConfirmPassword"
                           type="password"
                           class="w-full px-4 py-2 border rounded-lg" />
            </div>

            <button type="submit" class="w-full py-2 mt-4 font-semibold text-white bg-blue-600 rounded-lg">
                Create Account
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="text-center text-red-500">@Message</p>
        }
    </div>
</div>

@code {
    private SignupModel model = new();
    private string? Message;

    private async Task HandleSignup()
    {
        await DbContext.Database.EnsureCreatedAsync();

        if (await DbContext.Users.AnyAsync(u => u.Email == model.Email))
        {
            Message = "Email already exists";
            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            Message = "Passwords do not match";
            return;
        }

        var user = new Models.User
        {
            Email = model.Email,
            PasswordHash = PasswordHash.Hash(model.Password)
        };

        DbContext.Users.Add(user);
        await DbContext.SaveChangesAsync();

        Message = "Account created successfully 🎉";
    }

    public class SignupModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(6)]
        public string Password { get; set; } = string.Empty;

        [Required, Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
