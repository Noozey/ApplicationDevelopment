@page "/calendar"
@using MauiApp2.Models
@using MauiApp2.Services
@inject JournalService JournalService
@inject NavigationManager Nav
@inject AuthService AuthService

<div class="max-w-3xl mx-auto p-4 space-y-6">
    @* Header Section *@
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-foreground mb-2 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Journal Calendar
        </h2>
        <p class="text-secondary-foreground">View and navigate through your journal entries</p>
    </div>
   
    @* Calendar Card *@
    <div class="bg-card rounded-2xl shadow-xl border border-gray-200 p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-2xl font-bold text-foreground">@currentDate.ToString("MMMM yyyy")</h3>
            <div class="flex gap-2">
                <button @onclick="PrevMonth" 
                        class="p-2.5 rounded-xl transition-all hover-bg text-secondary-foreground hover:text-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
                <button @onclick="NextMonth" 
                        class="p-2.5 rounded-xl transition-all hover-bg text-secondary-foreground hover:text-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-7 gap-2">
            @foreach (var day in daysOfWeek)
            {
                <div class="text-center text-xs font-bold text-tertiary-foreground uppercase pb-3">@day</div>
            }

            @foreach (var emptyDay in Enumerable.Range(0, startOffset))
            {
                <div class="aspect-square"></div>
            }

            @for (int day = 1; day <= daysInMonth; day++)
            {
                var date = new DateTime(currentDate.Year, currentDate.Month, day);
                var hasEntry = journalEntries.Any(e => e.EntryDate.Date == date.Date);
                var isSelected = selectedDate.Date == date.Date;
                var isToday = date.Date == DateTime.Today;

                <button @onclick="() => OnDateClick(date)"
                        class="relative aspect-square flex items-center justify-center rounded-xl transition-all"
                        style="@(isSelected ? "background-color: var(--color-primary); color: var(--color-primary-foreground); box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);" : (isToday ? "background-color: var(--color-info-light); color: var(--color-info-foreground); border: 2px solid var(--color-info-border);" : ""))">

                    <span class="text-sm font-semibold z-10" 
                          style="@(!isSelected && !isToday ? "color: var(--color-foreground);" : "")">@day</span>

                    @if (hasEntry)
                    {
                        <span class="absolute bottom-1.5 w-2 h-2 rounded-full"
                              style="background-color: @(isSelected ? "white" : "var(--color-primary)");"></span>
                    }
                </button>
            }
        </div>
    </div>

    @* Entry Details Card *@
    <div class="bg-card rounded-2xl p-6 border border-gray-200 shadow-xl min-h-[200px]">
        <div class="flex justify-between items-start mb-4">
            <h3 class="text-sm font-bold text-tertiary-foreground uppercase tracking-wider flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                @selectedDate.ToString("dddd, MMMM dd, yyyy")
            </h3>
        </div>

        @if (isLoading)
        {
            <div class="flex justify-center items-center py-8">
                <div class="animate-spin rounded-full h-8 w-8 border-b-4 border-primary"></div>
            </div>
        }
        else if (selectedEntry != null)
        {
            <div class="space-y-4">
                <div class="flex flex-wrap gap-2">
                    <span class="px-4 py-2 rounded-xl text-sm font-semibold shadow-sm"
                          style="background-color: var(--color-primary); color: var(--color-primary-foreground);">
                        @selectedEntry.PrimaryMood
                    </span>
                    @if (!string.IsNullOrEmpty(selectedEntry.SecondaryMood1))
                    {
                        <span class="px-4 py-2 rounded-xl text-sm font-medium border-2 shadow-sm"
                              style="background-color: var(--color-info-light); color: var(--color-info-foreground); border-color: var(--color-info-border);">
                            @selectedEntry.SecondaryMood1
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(selectedEntry.Category))
                    {
                        <span class="px-4 py-2 rounded-xl text-sm font-medium border-2 shadow-sm"
                              style="background-color: var(--color-muted); color: var(--color-secondary-foreground); border-color: var(--color-border);">
                            @selectedEntry.Category
                        </span>
                    }
                </div>
                
                <div class="pt-2">
	                <div class="journal-rich-text mb-4 line-clamp-3 overflow-hidden text-foreground">
	                @((MarkupString) @selectedEntry.Content)
	                </div>
                </div>

                @if (!string.IsNullOrEmpty(selectedEntry.Tags))
                {
                    <div class="flex flex-wrap gap-2 pt-2">
                        @foreach (var tag in selectedEntry.Tags.Split(','))
                        {
                            <span class="px-3 py-1.5 rounded-lg text-xs font-medium border shadow-sm"
                                  style="background-color: var(--color-accent-light); color: var(--color-accent-foreground); border-color: var(--color-accent-border);">
                                @tag.Trim()
                            </span>
                        }
                    </div>
                }
		
                <div class="pt-4 border-t border-gray-200">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-tertiary-foreground font-medium">
                            @selectedEntry.WordCount words
                        </span>
						@if (selectedDate.Date == DateTime.Today)
						{
							<button @onclick="CreateNewEntry"
							        class="px-4 py-2 rounded-xl text-sm font-semibold transition-all hover:opacity-90"
							        style="background-color: var(--color-info); color: white;">
								Edit Entry
							</button>
						}
                    </div>
                </div>
			
            </div>
        }
        else
        {
            @if (selectedDate.Date == DateTime.Today) 
            {
                <div class="flex flex-col items-center justify-center py-10 text-center">
                    <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4"
                         style="background-color: var(--color-muted);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary-foreground">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                    </div>
                    <p class="text-secondary-foreground text-base mb-4 font-medium">No journal entry for today yet</p>
                    <button @onclick="CreateNewEntry" 
                            class="px-6 py-3 rounded-xl text-sm font-semibold shadow-lg transition-all hover:opacity-90 flex items-center gap-2"
                            style="background-color: var(--color-primary); color: var(--color-primary-foreground);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Write Today's Entry
                    </button>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center justify-center py-10 text-center">
                    <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4"
                         style="background-color: var(--color-muted);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-tertiary-foreground">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                        </svg>
                    </div>
                    <p class="text-tertiary-foreground text-base font-medium">No journal entry recorded for this date</p>
                </div>
            }
        }
    </div>
</div>

@code {
    private DateTime currentDate = DateTime.Now;
    private DateTime selectedDate = DateTime.Now;
    private List<JournalEntry> journalEntries = new();
    private JournalEntry? selectedEntry;
    private bool isLoading = true;
    private int userId => AuthService.UserId ?? 0;
    private string[] daysOfWeek = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    private int daysInMonth => DateTime.DaysInMonth(currentDate.Year, currentDate.Month);
    private int startOffset => (int)new DateTime(currentDate.Year, currentDate.Month, 1).DayOfWeek;
  
    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        isLoading = true;
        journalEntries = await JournalService.GetAllEntriesForUser(userId);
        UpdateSelectedView();
        isLoading = false;
    }

    private void OnDateClick(DateTime date)
    {
        selectedDate = date;
        UpdateSelectedView();
    }

    private void UpdateSelectedView()
    {
        selectedEntry = journalEntries.FirstOrDefault(e => e.EntryDate.Date == selectedDate.Date);
    }

    private void PrevMonth() => currentDate = currentDate.AddMonths(-1);
    private void NextMonth() => currentDate = currentDate.AddMonths(1);

    private void CreateNewEntry()
    {
        Nav.NavigateTo("/create");
    }
}

<style>
     b,
    strong {
        font-weight: 700;
        color: var(--color-primary); 
    }

    i,
    em {
        font-style: italic;
    }

    p {
        margin-bottom: 0.75rem;
    }

    ul {
        list-style-type: disc;
        margin-left: 1.25rem;
        margin-bottom: 1rem;
    }

    h1,
    h2,
    h3 {
        font-weight: bold;
        line-height: 1.25;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }
</style>