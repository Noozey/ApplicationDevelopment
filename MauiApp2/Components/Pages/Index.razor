@page "/"
@inject NavigationManager NavigationManager


<div class="space-y-4 ">
            <div class="flex flex-row gap-3 mb-6">
                <div class="w-full items-center justify-between">

                    <input type="text" placeholder="Search entries..." class="w-full p-4 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">

                </div>
                <a href="/create" class="px-4 py-2 border border-gray-300 rounded-lg hover-bg flex items-center gap-2 transition-colors flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                    <span>Filters</span>
                </a>
            </div>
        </div>
<div class="bg-white rounded-lg shadow p-6 hover:shadow-lg transition-shadow">
    <div class="flex justify-between items-start mb-3 flex-wrap gap-2">
        <div class="flex-1">
            <h3 class="text-lg font-semibold text-foreground mb-1">December 18, 2025</h3>
            <div class="flex gap-2 items-center text-sm text-secondary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>Updated 2 hours ago</span>
            </div>
        </div>
        <div class="flex gap-2 flex-shrink-0">
            <button class="p-2 hover-bg rounded transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            </button>
            <button class="p-2 hover-bg rounded transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
        </div>
    </div>

    <div class="flex gap-2 mb-3 flex-wrap">
        <span class="px-3 py-1 rounded-full text-sm border bg-success-light text-success-foreground border-success font-medium">Happy</span>
        <span class="px-3 py-1 rounded-full text-sm border bg-muted text-info-foreground border-info">Calm</span>
    </div>

    <p class="text-secondary-foreground mb-3 line-clamp-3">
        Today was a wonderful day. I spent time working on my projects and felt really productive.
        The weather was beautiful and I managed to go for a walk in the evening...
    </p>

    <div class="flex flex-wrap gap-2">
        <span class="px-2 py-1 bg-muted text-accent-foreground rounded text-xs border border-accent">Work</span>
        <span class="px-2 py-1 bg-muted text-accent-foreground rounded text-xs border border-accent">Personal Growth</span>
        <span class="px-2 py-1 bg-muted text-accent-foreground rounded text-xs border border-accent">Exercise</span>
    </div>
</div>
