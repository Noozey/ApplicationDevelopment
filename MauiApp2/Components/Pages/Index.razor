@page "/"
@using MauiApp2.Services
@using MauiApp2.Models
@inject JournalService JournalService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="space-y-4">
    <div class="flex flex-row gap-3 mb-6">
        <div class="w-full items-center justify-between">
            @* Data-bind the search input *@
            <input type="text" @bind="searchTerm" @bind:event="oninput"
                   placeholder="Search entries..."
                   class="w-full p-4 border-2 bg-background text-foreground rounded-lg focus:ring-2 focus:border-accent transition-all shadow-sm"
                   style="border-color: var(--color-muted);">
        </div>
        <button class="px-6 py-4 border-2 rounded-lg hover-bg hover-border flex items-center gap-2 transition-all flex-shrink-0 shadow-sm font-medium bg-background text-accent-foreground"
                style="border-color: var(--color-muted);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            <span>Filters</span>
        </button>
    </div>
</div>

@if (FilteredEntries == null)
{
    <div class="flex justify-center p-10">
        <div class="animate-spin rounded-full h-12 w-12 border-b-4 border-accent"></div>
    </div>
}
else if (!FilteredEntries.Any())
{
    <div class="text-center p-12 bg-muted rounded-2xl border-2 border-dashed border-accent">
        <p class="text-secondary-foreground text-lg mb-2">No journal entries found. Start writing today!</p>
        <button class="mt-4 px-6 py-3 bg-primary text-white font-semibold rounded-xl hover:opacity-90 transition-all shadow-md"
                @onclick='() => NavigationManager.NavigateTo("/create")'>
            + Create First Entry
        </button>
    </div>
}
else
{
    @foreach (var entry in FilteredEntries)
    {
        <div class="bg-background rounded-2xl shadow-md hover:shadow-xl transition-all mb-4 border overflow-hidden"
             style="border-color: var(--color-muted);">
            <div class="p-6">
                <div class="flex justify-between items-start mb-3 flex-wrap gap-2">
                    <div class="flex-1">
                        <h3 class="text-xl font-bold text-foreground mb-1">@entry.EntryDate.ToString("MMMM dd, yyyy")</h3>
                        <div class="flex gap-2 items-center text-sm text-secondary-foreground">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>Updated @GetTimeAgo(entry.UpdatedAt)</span>
                        </div>
                    </div>
                    <div class="flex gap-2 flex-shrink-0">
                        @* Edit Button *@
                        @if (entry.EntryDate.Date == DateTime.Today)
                        {
                            <button class="p-2 rounded-lg transition-colors text-info-foreground"
									onmouseover="this.style.backgroundColor='var(--color--light, #fee2e2)';"
									onmouseout="this.style.backgroundColor='transparent';"
                                    @onclick="() => EditEntry(entry.EntryDate)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                        }
                        @* Delete Button *@
                        <button class="p-2 rounded-lg transition-colors text-destructive-foreground"
                                style="background-color: transparent;"
                                onmouseover="this.style.backgroundColor='var(--color-destructive-light, #fee2e2)';"
                                onmouseout="this.style.backgroundColor='transparent';"
                                @onclick="() => DeleteEntry(entry)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </div>
                </div>

                @* Mood Badges *@
                <div class="flex gap-2 mb-4 flex-wrap">
                    <span class="px-4 py-2 rounded-full text-sm border-2 border-accent bg-primay text-accent-foreground font-semibold shadow-sm">@entry.PrimaryMood</span>
                    @if (!string.IsNullOrEmpty(entry.SecondaryMood1))
                    {
                        <span class="px-4 py-2 rounded-full text-sm border-2 bg-muted text-foreground font-medium shadow-sm"
                              style="border-color: var(--color-muted);">@entry.SecondaryMood1</span>
                    }
					 @if (!string.IsNullOrEmpty(entry.SecondaryMood2))
                    {
                        <span class="px-4 py-2 rounded-full text-sm border-2 bg-muted text-foreground font-medium shadow-sm"
                              style="border-color: var(--color-muted);">@entry.SecondaryMood2</span>
                    }
                </div>

                <p class="text-foreground mb-4 line-clamp-3" style="line-height: 1.6;">
                    @entry.Content
                </p>

                @* Tags *@
                <div class="flex flex-wrap gap-2">
                    @if (!string.IsNullOrEmpty(entry.Tags))
                    {
                        @foreach (var tag in entry.Tags.Split(','))
                        {
                            <span class="px-3 py-1.5 bg-success-light text-success-foreground border-success rounded-lg text-xs border font-medium shadow-sm">@tag.Trim()</span>
                        }
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<JournalEntry> allEntries;
    private string searchTerm = "";

    // Filtering logic
    private IEnumerable<JournalEntry> FilteredEntries =>
        string.IsNullOrWhiteSpace(searchTerm)
        ? allEntries
        : allEntries.Where(e => e.Content.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                e.PrimaryMood.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var userId = AuthService.UserId ?? 0;
        if (userId == 0)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        // Fetch all entries for this user, ordered by newest first
        allEntries = await JournalService.GetAllEntriesForUser(userId);
    }

    private void EditEntry(DateTime date)
    {
        // Navigate to create page (our create page logic already handles loading existing data for a date)
        NavigationManager.NavigateTo("/create");
    }

    private async Task DeleteEntry(JournalEntry entry)
    {
        // Add a Delete method to your JournalService
        await JournalService.DeleteEntry(entry);
        allEntries.Remove(entry);
    }

    private string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.Now - dateTime;
        if (span.TotalDays > 1) return $"{(int)span.TotalDays} days ago";
        if (span.TotalHours > 1) return $"{(int)span.TotalHours} hours ago";
        return "Just now";
    }
}
