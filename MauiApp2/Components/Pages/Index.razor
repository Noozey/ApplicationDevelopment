@page "/"
@using MauiApp2.Services
@using MauiApp2.Models
@inject JournalService JournalService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<div class="space-y-6">
    @* Search and Filter Bar *@
    <div class="flex flex-row gap-3">
        <div class="flex-1 relative">
            <div class="absolute left-4 top-1/2 transform -translate-y-1/2 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-tertiary-foreground">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
            </div>
            <input type="text" @bind="searchTerm" @bind:event="oninput" @bind:after="ResetPagination"
                   placeholder="Search by content, mood, or tags..."
                   class="w-full pl-12 pr-4 py-4 border-2 bg-background text-foreground rounded-xl focus:ring-2 focus:border-primary transition-all shadow-sm font-medium"
                   style="border-color: var(--color-input);">
        </div>
        <button @onclick="ToggleFilters"
                class="px-6 py-4 border-2 rounded-xl hover-bg hover-border flex items-center gap-2 transition-all flex-shrink-0 shadow-sm font-semibold text-secondary-foreground @(showFilters ? "bg-primary text-white" : "")"
                style="@(showFilters ? "background-color: var(--color-primary) !important; color: var(--color-primary-foreground) !important;" : "border-color: var(--color-input); background-color: var(--color-background);")">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span>Filters</span>
            @if (ActiveFilterCount > 0)
            {
                <span class="bg-white text-primary rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold">
                    @ActiveFilterCount
                </span>
            }
        </button>
        <button @onclick="DownloadPdf"
                class="px-6 py-4 border-2 rounded-xl hover:bg-primary hover:text-white flex items-center gap-2 transition-all shadow-sm font-semibold text-secondary-foreground"
                style="border-color: var(--color-input);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Export PDF</span>
        </button>
    </div>

    @* Filter Panel *@
    @if (showFilters)
    {
        <div class="bg-card border-2 rounded-2xl p-6 shadow-lg" style="border-color: var(--color-border);">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @* Date Range Filter *@
                <div>
                    <label class="block text-sm font-semibold text-foreground mb-3">Date Range</label>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs text-secondary-foreground mb-1">From</label>
                            <input type="date" @bind="filterStartDate" @bind:after="ResetPagination"
                                   class="w-full px-3 py-2 border-2 rounded-lg text-sm"
                                   style="border-color: var(--color-input);">
                        </div>
                        <div>
                            <label class="block text-xs text-secondary-foreground mb-1">To</label>
                            <input type="date" @bind="filterEndDate" @bind:after="ResetPagination"
                                   class="w-full px-3 py-2 border-2 rounded-lg text-sm"
                                   style="border-color: var(--color-input);">
                        </div>
                    </div>
                </div>

                @* Mood Filter *@
                <div>
                    <label class="block text-sm font-semibold text-foreground mb-3">Moods</label>
                    <div class="space-y-2 max-h-40 overflow-y-auto">
                        @foreach (var mood in AvailableMoods)
                        {
                            <label class="flex items-center gap-2 cursor-pointer hover:bg-muted p-2 rounded-lg transition-all">
                                <input type="checkbox"
                                       checked="@selectedMoods.Contains(mood)"
                                       @onchange="() => ToggleMood(mood)"
                                       class="w-4 h-4 rounded border-2"
                                       style="accent-color: var(--color-primary);">
                                <span class="text-sm text-foreground">@mood</span>
                            </label>
                        }
                    </div>
                </div>

                @* Tag Filter *@
                <div>
                    <label class="block text-sm font-semibold text-foreground mb-3">Tags</label>
                    <div class="space-y-2 max-h-40 overflow-y-auto">
                        @foreach (var tag in AvailableTags)
                        {
                            <label class="flex items-center gap-2 cursor-pointer hover:bg-muted p-2 rounded-lg transition-all">
                                <input type="checkbox"
                                       checked="@selectedTags.Contains(tag)"
                                       @onchange="() => ToggleTag(tag)"
                                       class="w-4 h-4 rounded border-2"
                                       style="accent-color: var(--color-primary);">
                                <span class="text-sm text-foreground">@tag</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            @* Filter Actions *@
            <div class="flex justify-end gap-3 mt-6 pt-4 border-t" style="border-color: var(--color-border);">
                <button @onclick="ClearFilters"
                        class="px-4 py-2 rounded-lg text-sm font-semibold text-secondary-foreground hover:bg-muted transition-all">
                    Clear All
                </button>
                <button @onclick="() => showFilters = false"
                        class="px-4 py-2 rounded-lg text-sm font-semibold transition-all"
                        style="background-color: var(--color-primary); color: var(--color-primary-foreground);">
                    Apply Filters
                </button>
            </div>
        </div>
    }

    @* Results Summary *@
    @if (allEntries != null && FilteredEntries.Any())
    {
        <div class="flex items-center justify-between px-2">
            <p class="text-sm text-secondary-foreground font-medium">
                Showing <span class="font-bold text-foreground">@PaginatedEntries.Count()</span> of
                <span class="font-bold text-foreground">@FilteredEntries.Count()</span>
                @(FilteredEntries.Count() == 1 ? "entry" : "entries")
            </p>
            @if (!string.IsNullOrWhiteSpace(searchTerm) || ActiveFilterCount > 0)
            {
                <button @onclick="ClearAllSearchAndFilters"
                        class="text-sm text-primary font-semibold hover:underline flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    Clear all filters
                </button>
            }
        </div>
    }
</div>

@if (allEntries == null)
{
    <div class="flex flex-col justify-center items-center p-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-4 border-primary mb-4"></div>
        <p class="text-secondary-foreground font-medium">Loading your entries...</p>
    </div>
}
else if (!FilteredEntries.Any())
{
    <div class="text-center p-16 bg-muted/50 rounded-2xl border-2 border-dashed mt-6" style="border-color: var(--color-border);">
        <div class="w-20 h-20 mx-auto mb-4 rounded-full flex items-center justify-center" style="background-color: var(--color-primary); opacity: 0.1;">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
        </div>
        <h3 class="text-xl font-bold text-foreground mb-2">
            @(string.IsNullOrWhiteSpace(searchTerm) && ActiveFilterCount == 0 ? "No journal entries yet" : "No matching entries found")
        </h3>
        <p class="text-secondary-foreground mb-6">
            @(string.IsNullOrWhiteSpace(searchTerm) && ActiveFilterCount == 0 ? "Start your journaling journey today!" : "Try adjusting your search terms or filters")
        </p>
        @if (string.IsNullOrWhiteSpace(searchTerm) && ActiveFilterCount == 0)
        {
            <button class="px-8 py-3 font-semibold rounded-xl hover:opacity-90 transition-all shadow-lg flex items-center gap-2 mx-auto"
                    style="background-color: var(--color-primary); color: var(--color-primary-foreground);"
                    @onclick='() => NavigationManager.NavigateTo("/create")'>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create First Entry
            </button>
        }
        else
        {
            <button @onclick="ClearAllSearchAndFilters"
                    class="px-6 py-2 rounded-lg font-semibold transition-all"
                    style="background-color: var(--color-primary); color: var(--color-primary-foreground);">
                Clear Filters
            </button>
        }
    </div>
}
else
{
    <div class="space-y-4 mt-6">
        @foreach (var entry in PaginatedEntries)
        {
            <div class="bg-card rounded-2xl shadow-md hover:shadow-xl transition-all border overflow-hidden group"
                 style="border-color: var(--color-border);">
                <div class="p-6">
                    <div class="flex justify-between items-start mb-4 flex-wrap gap-3">
                        <div class="flex-1">
                            <h3 class="text-xl font-bold text-foreground mb-2 flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-primary);">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                @entry.EntryDate.ToString("MMMM dd, yyyy")
                            </h3>
                            <div class="flex gap-3 items-center text-sm text-tertiary-foreground">
                                <div class="flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span>@GetTimeAgo(entry.UpdatedAt)</span>
                                </div>
                                <span class="w-1 h-1 rounded-full bg-tertiary-foreground"></span>
                                <div class="flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="17" y1="10" x2="3" y2="10"></line>
                                        <line x1="21" y1="6" x2="3" y2="6"></line>
                                        <line x1="21" y1="14" x2="3" y2="14"></line>
                                        <line x1="17" y1="18" x2="3" y2="18"></line>
                                    </svg>
                                    <span>@entry.WordCount words</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex gap-2 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
                            @if (entry.EntryDate.Date == DateTime.Today)
                            {
                                <button class="p-2.5 rounded-xl transition-all hover:bg-info-light border-2 border-transparent hover:border-info-border"
                                        style="color: var(--color-info-foreground);"
                                        title="Edit entry"
                                        @onclick="() => EditEntry(entry.EntryDate)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </button>
                            }
                            <button class="p-2.5 rounded-xl transition-all hover:bg-destructive-light border-2 border-transparent hover:border-destructive-border"
                                    style="color: var(--color-destructive-foreground);"
                                    title="Delete entry"
                                    @onclick="() => DeleteEntry(entry)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                </svg>
                            </button>
                        </div>
                    </div>

                    @* Mood Badges *@
                    <div class="flex gap-2 mb-4 flex-wrap">
                        <span class="px-4 py-2 rounded-full text-sm font-semibold shadow-sm border-2"
                              style="background-color: var(--color-primary); color: var(--color-primary-foreground); border-color: var(--color-primary);">
                            @entry.PrimaryMood
                        </span>
                        @if (!string.IsNullOrEmpty(entry.SecondaryMood1))
                        {
                            <span class="px-4 py-2 rounded-full text-sm font-medium shadow-sm border-2 bg-info-light"
                                  style="border-color: var(--color-info-border); color: var(--color-info-foreground);">
                                @entry.SecondaryMood1
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(entry.SecondaryMood2))
                        {
                            <span class="px-4 py-2 rounded-full text-sm font-medium shadow-sm border-2 bg-info-light"
                                  style="border-color: var(--color-info-border); color: var(--color-info-foreground);">
                                @entry.SecondaryMood2
                            </span>
                        }
                    </div>

                    @* Content Preview *@
                    <div class="journal-rich-text mb-4 text-foreground">
                        @((MarkupString)entry.Content)
                    </div>

                    @* Tags *@
                    @if (!string.IsNullOrEmpty(entry.Tags))
                    {
                        <div class="flex flex-wrap gap-2 pt-3 border-t border-gray-200">
                            @foreach (var tag in entry.Tags.Split(','))
                            {
                                <span class="px-3 py-1.5 bg-accent-light rounded-lg text-xs font-medium border shadow-sm"
                                      style="border-color: var(--color-accent-border); color: var(--color-accent-foreground);">
                                    @tag.Trim()
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* Pagination UI *@
    @if (TotalPages > 1)
    {
        <div class="flex items-center justify-between mt-8 mb-8 px-2">
            <button @onclick="PreviousPage"
                    disabled="@(currentPage == 1)"
                    class="px-5 py-2.5 rounded-xl border-2 font-semibold transition-all disabled:opacity-30 disabled:cursor-not-allowed hover:bg-muted flex items-center gap-2"
                    style="border-color: var(--color-border); background-color: var(--color-background); color: var(--color-foreground);">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
                Previous
            </button>

            <div class="flex items-center gap-2">
                @if (TotalPages <= 7)
                {
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNumber = i;
                        <button @onclick="() => GoToPage(pageNumber)"
                                class="w-10 h-10 rounded-xl border-2 font-bold transition-all"
                                style="@(currentPage == pageNumber ? "background-color: var(--color-primary); color: var(--color-primary-foreground); border-color: var(--color-primary);" : "background-color: var(--color-background); border-color: var(--color-border); color: var(--color-foreground);")">
                            @pageNumber
                        </button>
                    }
                }
                else
                {
                    @* Show smart pagination for many pages *@
                    @if (currentPage > 3)
                    {
                        <button @onclick="() => GoToPage(1)" class="w-10 h-10 rounded-xl border-2 font-bold transition-all" style="background-color: var(--color-background); border-color: var(--color-border); color: var(--color-foreground);">1</button>
                        <span class="text-tertiary-foreground">...</span>
                    }

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(TotalPages, currentPage + 2); i++)
                    {
                        var pageNumber = i;
                        <button @onclick="() => GoToPage(pageNumber)"
                                class="w-10 h-10 rounded-xl border-2 font-bold transition-all"
                                style="@(currentPage == pageNumber ? "background-color: var(--color-primary); color: var(--color-primary-foreground); border-color: var(--color-primary);" : "background-color: var(--color-background); border-color: var(--color-border); color: var(--color-foreground);")">
                            @pageNumber
                        </button>
                    }

                    @if (currentPage < TotalPages - 2)
                    {
                        <span class="text-tertiary-foreground">...</span>
                        <button @onclick="() => GoToPage(TotalPages)" class="w-10 h-10 rounded-xl border-2 font-bold transition-all" style="background-color: var(--color-background); border-color: var(--color-border); color: var(--color-foreground);">@TotalPages</button>
                    }
                }
            </div>

            <button @onclick="NextPage"
                    disabled="@(currentPage == TotalPages)"
                    class="px-5 py-2.5 rounded-xl border-2 font-semibold transition-all disabled:opacity-30 disabled:cursor-not-allowed hover:bg-muted flex items-center gap-2"
                    style="border-color: var(--color-border); background-color: var(--color-background); color: var(--color-foreground);">
                Next
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </button>
        </div>
    }
}

<style>
    b,
    strong {
        font-weight: 700;
        color: var(--color-primary);
    }

    i,
    em {
        font-style: italic;
    }

    p {
        margin-bottom: 0.75rem;
    }

    ul {
        list-style-type: disc;
        margin-left: 1.25rem;
        margin-bottom: 1rem;
    }

    h1,
    h2,
    h3 {
        font-weight: bold;
        line-height: 1.25;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }
</style>

@code {
    private List<JournalEntry> allEntries;
    private string searchTerm = "";

    // Filter state
    private bool showFilters = false;
    private DateTime? filterStartDate;
    private DateTime? filterEndDate;
    private HashSet<string> selectedMoods = new();
    private HashSet<string> selectedTags = new();

    // Pagination
    private int currentPage = 1;
    private int pageSize = 5;

    // Available options for filters (computed from all entries)
    private List<string> AvailableMoods
    {
        get
        {
            if (allEntries == null) return new List<string>();

            var moods = new HashSet<string>();
            foreach (var entry in allEntries)
            {
                if (!string.IsNullOrEmpty(entry.PrimaryMood))
                    moods.Add(entry.PrimaryMood);
                if (!string.IsNullOrEmpty(entry.SecondaryMood1))
                    moods.Add(entry.SecondaryMood1);
                if (!string.IsNullOrEmpty(entry.SecondaryMood2))
                    moods.Add(entry.SecondaryMood2);
            }
            return moods.OrderBy(m => m).ToList();
        }
    }

    private List<string> AvailableTags
    {
        get
        {
            if (allEntries == null) return new List<string>();

            var tags = new HashSet<string>();
            foreach (var entry in allEntries)
            {
                if (!string.IsNullOrEmpty(entry.Tags))
                {
                    foreach (var tag in entry.Tags.Split(','))
                    {
                        var trimmedTag = tag.Trim();
                        if (!string.IsNullOrEmpty(trimmedTag))
                            tags.Add(trimmedTag);
                    }
                }
            }
            return tags.OrderBy(t => t).ToList();
        }
    }

    private int ActiveFilterCount
    {
        get
        {
            int count = 0;
            if (filterStartDate.HasValue) count++;
            if (filterEndDate.HasValue) count++;
            count += selectedMoods.Count;
            count += selectedTags.Count;
            return count;
        }
    }

    private IEnumerable<JournalEntry> FilteredEntries
    {
        get
        {
            if (allEntries == null) return new List<JournalEntry>();

            var filtered = allEntries.AsEnumerable();

            // Search term filter (searches content, moods, and tags)
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.ToLower();
                filtered = filtered.Where(e =>
                    (e.Content?.ToLower().Contains(term) ?? false) ||
                    (e.PrimaryMood?.ToLower().Contains(term) ?? false) ||
                    (e.SecondaryMood1?.ToLower().Contains(term) ?? false) ||
                    (e.SecondaryMood2?.ToLower().Contains(term) ?? false) ||
                    (e.Tags?.ToLower().Contains(term) ?? false)
                );
            }

            // Date range filter
            if (filterStartDate.HasValue)
            {
                filtered = filtered.Where(e => e.EntryDate.Date >= filterStartDate.Value.Date);
            }
            if (filterEndDate.HasValue)
            {
                filtered = filtered.Where(e => e.EntryDate.Date <= filterEndDate.Value.Date);
            }

            // Mood filter
            if (selectedMoods.Any())
            {
                filtered = filtered.Where(e =>
                    selectedMoods.Contains(e.PrimaryMood) ||
                    (e.SecondaryMood1 != null && selectedMoods.Contains(e.SecondaryMood1)) ||
                    (e.SecondaryMood2 != null && selectedMoods.Contains(e.SecondaryMood2))
                );
            }

            // Tag filter
            if (selectedTags.Any())
            {
                filtered = filtered.Where(e =>
                {
                    if (string.IsNullOrEmpty(e.Tags)) return false;
                    var entryTags = e.Tags.Split(',').Select(t => t.Trim());
                    return entryTags.Any(t => selectedTags.Contains(t));
                });
            }

            return filtered.OrderByDescending(e => e.EntryDate);
        }
    }

    private IEnumerable<JournalEntry> PaginatedEntries =>
        FilteredEntries
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    private int TotalPages => (int)Math.Ceiling((double)FilteredEntries.Count() / pageSize);

    protected override async Task OnInitializedAsync()
    {
        var userId = AuthService.UserId ?? 0;
        if (userId == 0)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        allEntries = await JournalService.GetAllEntriesForUser(userId);
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private void ToggleMood(string mood)
    {
        if (selectedMoods.Contains(mood))
            selectedMoods.Remove(mood);
        else
            selectedMoods.Add(mood);
        ResetPagination();
    }

    private void ToggleTag(string tag)
    {
        if (selectedTags.Contains(tag))
            selectedTags.Remove(tag);
        else
            selectedTags.Add(tag);
        ResetPagination();
    }

    private void ClearFilters()
    {
        filterStartDate = null;
        filterEndDate = null;
        selectedMoods.Clear();
        selectedTags.Clear();
        ResetPagination();
    }

    private void ClearAllSearchAndFilters()
    {
        searchTerm = "";
        ClearFilters();
    }

    private void ResetPagination() => currentPage = 1;
    private void ClearSearch() => searchTerm = "";
    private void GoToPage(int page) => currentPage = page;

    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }

    private void PreviousPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void EditEntry(DateTime date)
    {
        NavigationManager.NavigateTo("/create");
    }

    private async Task DeleteEntry(JournalEntry entry)
    {
        var confirmed = await App.Current.MainPage.DisplayAlert("Delete", "Are you sure?", "Yes", "No");
        if (confirmed)
        {
            await JournalService.DeleteEntry(entry);
            allEntries.Remove(entry);

            if (!PaginatedEntries.Any() && currentPage > 1)
            {
                currentPage--;
            }
        }
    }

    private string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.Now - dateTime;
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d ago";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h ago";
        return "Just now";
    }

    private async Task DownloadPdf()
    {
        try
        {
            var entries = FilteredEntries.ToList();
            var pdfBytes = await Task.Run(() => new ExportService().GenerateJournalPdf(entries));

            string fileName = $"Journal_Export_{DateTime.Now:yyyyMMdd}.pdf";
            string targetFile = Path.Combine(FileSystem.Current.CacheDirectory, fileName);

            await File.WriteAllBytesAsync(targetFile, pdfBytes);

            await Task.Yield();

            await Share.Default.RequestAsync(new ShareFileRequest
            {
                Title = "Export Journal",
                File = new ShareFile(targetFile)
            });
        }
        catch (Exception ex)
        {
            await App.Current.MainPage.DisplayAlert("Export", "Could not open share dialog. Please try again.", "OK");
        }
    }
}
