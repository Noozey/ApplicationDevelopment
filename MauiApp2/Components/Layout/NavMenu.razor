@using MauiApp2.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<header class="bg-card rounded-b-2xl shadow-xl mb-6 overflow-hidden border border-gray-200">
    <div class="p-8">
        <div class="flex justify-between items-center flex-wrap gap-4 mb-6">
            <div class="flex-shrink-0">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                    </div>
                    <h1 class="text-3xl font-bold text-foreground">My Journal</h1>
                </div>
                <p class="text-secondary-foreground text-sm ml-13">
                    Track your thoughts, moods, and daily experiences
                </p>
            </div>

            <div class="flex items-center gap-3">
                <NavLink href="/create"
                         class="px-6 py-3 bg-primary text-primary-foreground rounded-xl flex items-center gap-2 shadow-lg hover:opacity-90 transition-all font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>New Entry</span>
                </NavLink>

                <button @onclick="Logout"
                        class="p-3 rounded-xl transition-all hover-bg text-secondary-foreground hover:text-destructive-foreground"
                        title="Logout">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                </button>
            </div>
        </div>

        <div class="flex gap-3 flex-wrap">
            <NavLink href="/"
                     class="nav-tab px-5 py-2.5 rounded-xl font-semibold transition-all flex items-center gap-2"
                     ActiveClass="nav-tab-active"
                     Match="NavLinkMatch.All">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                <span>Entries</span>
            </NavLink>

            <NavLink href="/dashboard"
                     class="nav-tab px-5 py-2.5 rounded-xl font-semibold transition-all flex items-center gap-2"
                     ActiveClass="nav-tab-active">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                <span>Analytics</span>
            </NavLink>

            <NavLink href="/calendar"
                     class="nav-tab px-5 py-2.5 rounded-xl font-semibold transition-all flex items-center gap-2"
                     ActiveClass="nav-tab-active">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Calendar</span>
            </NavLink>
        </div>
    </div>
</header>

<style>
    .nav-tab {
        background-color: transparent;
        color: var(--color-secondary-foreground);
        border: 2px solid transparent;
    }

        .nav-tab:hover {
            background-color: var(--color-hover-background);
            color: var(--color-foreground);
        }

    .nav-tab-active {
        background-color: var(--color-primary);
        color: var(--color-primary-foreground);
        border-color: var(--color-primary);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
    }

        .nav-tab-active:hover {
            background-color: var(--color-primary);
            color: var(--color-primary-foreground);
            opacity: 0.95;
        }
</style>

@code
{
    private void Logout()
    {
        AuthService.Logout();
        NavigationManager.NavigateTo("/login", true);
    }
}
