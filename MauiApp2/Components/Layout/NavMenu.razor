@using MauiApp2.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<header class="bg-white rounded-lg shadow-lg p-6 mb-6" style="padding:32px;">
	<div class="flex justify-between items-center flex-wrap gap-4">
		<div class="flex-shrink-0">
			<h1 class="text-3xl font-bold text-foreground mb-2">My Journal</h1>
			<p class="text-secondary-foreground">
				Track your thoughts, moods, and daily experiences
			</p>
		</div>

		<NavLink href="/create"
		         class="px-6 py-3 bg-primary text-primary-foreground rounded-lg flex items-center gap-2 shadow-md hover:opacity-90 transition-opacity flex-shrink-0">
			<span>New Entry</span>
		</NavLink>
		<button @onclick="Logout">logout</button>
	</div>

	<div class="flex gap-4 mt-6 flex-wrap">
		<NavLink href="/" class="px-6 py-2 rounded-lg font-medium bg-primary text-primary-foreground">
			Journal Entries
		</NavLink>

		<NavLink href="/dashboard" class="px-6 py-2 rounded-lg font-medium bg-muted text-secondary-foreground hover:bg-muted/80">
			Analytics
		</NavLink>

		<NavLink href="/calendar" class="px-6 py-2 rounded-lg font-medium bg-muted text-secondary-foreground hover:bg-muted/80">
			Calendar
		</NavLink>
	</div>
</header>

@code
{
	private void Logout()
	{
		AuthService.Logout();
		NavigationManager.NavigateTo("/login", true);
	}
}
